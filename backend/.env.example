# ==========================================
# AutoML Studio - Production Environment
# ==========================================

# Django Settings Module (Must be set for production)
DJANGO_SETTINGS_MODULE=config.settings.prod

# Secret Key for Django (Generate a secure random string)
SECRET_KEY=replace_with_a_highly_secure_random_string

# Secret Key for JWT Authentication (Generate a secure random string)
JWT_SECRET=replace_with_a_secure_jwt_string

# Allowed Hosts (Comma separated list of domains/IPs the backend is hosted on)
ALLOWED_HOSTS=api.automlstudio.com,localhost,127.0.0.1

# Database Configuration (PostgreSQL recommended for production)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://automl:automlpassword@localhost:5432/automl_db

# CORS Configuration (Comma separated list of allowed frontend origins)
CORS_ALLOWED_ORIGINS=https://automlstudio.com,http://localhost:3000
